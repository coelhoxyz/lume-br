{
  "name": "lume-br",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "check": "astro check",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts workers/collector/*.test.ts",
    "test:e2e": "playwright test",
    "cf:types": "wrangler types --include-runtime false",
    "db:migrate": "wrangler d1 migrations apply lume-db --local",
    "deploy": "npm run build && wrangler deploy",
    "precheck": "npm run cf:types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.3",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/sora": "^5.2.8",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0",
    "wrangler": "4.147.0"
  }
}
